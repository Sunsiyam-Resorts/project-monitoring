# Pooled PostgreSQL connection URL from your database provider. Use TLS in production.
DATABASE_URL=
# First admin is created only when the database is empty. Password: at least 12 characters.
ADMIN_USERNAME=abuney
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 64 hex characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=
# Required for email OTP password reset. A verified sender is needed.
RESEND_API_KEY=
MAIL_FROM=
