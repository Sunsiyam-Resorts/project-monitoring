# Docker deployment: see docs/DEPLOYMENT.md. Keep the real .env private (chmod 600) and never commit it.
# Database password for the PostgreSQL container. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host port for the portal (plain HTTP). Default 3000.
PORTAL_PORT=3000
# Local `npm run dev` only. In Docker, compose.yaml sets DATABASE_URL, HOST and PORT for the portal container.
DATABASE_URL=
# First admin is created only when the database is empty. Password: 12-256 characters; keep the single quotes.
ADMIN_USERNAME=abuney
ADMIN_EMAIL=
ADMIN_PASSWORD=''
# 64 hex characters; generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
# Required for email OTP password reset. A verified sender is needed.
RESEND_API_KEY=
MAIL_FROM=
# Shared secret for ERP single sign-on (at least 32 bytes). Must match the ERP's PROJECT_MONITORING_SSO_SECRET.
# Generate with: openssl rand -base64 32. Leave empty to disable ERP sign-in.
ERP_SSO_SECRET=
# Leave unset on plain HTTP. Set NODE_ENV=production only behind HTTPS (it marks the session cookie Secure).
# NODE_ENV=production
